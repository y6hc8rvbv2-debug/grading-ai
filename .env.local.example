# Supabase ダッシュボード > Project Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# サーバー専用。絶対に NEXT_PUBLIC_ を付けない。
# 付けるとブラウザに露出し、RLSを無視して全校のデータが読めてしまう。
# 使うのは：本人によるアカウントの削除（app/api/account/delete）・保存期間の削除（app/api/retention/purge）だけ
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 保存期間を過ぎた答案の削除（Vercel Cron が毎日1回。vercel.json）の認証。32文字以上の乱数
#   作り方: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=

# 公開の情報（ストア・プライバシーポリシー・利用規約・お問い合わせ。docs/STORE-RELEASE.md の 1.）
# NEXT_PUBLIC_APP_PROVIDER=提供者名（開発者アカウントの名義と同じ）
# NEXT_PUBLIC_SUPPORT_EMAIL=support@example.jp
# NEXT_PUBLIC_APP_URL=https://saiten.example.jp

# 採点AI。サーバー側（app/api/grade）からのみ使う。絶対に NEXT_PUBLIC_ を付けない。
# 未設定なら、答案は「AI採点待ち」で保存されるだけになる。
ANTHROPIC_API_KEY=sk-ant-...

# 任意。採点に使うモデル（既定: claude-opus-5）
# ANTHROPIC_MODEL=claude-opus-5
# 任意。AIが採点を断ったときに別モデルで自動再実行する機能を切るときだけ off
# ANTHROPIC_FALLBACKS=off
# 任意。採点方式「3モデル併用」の1段目・2段目のモデル（既定: claude-haiku-4-5 / claude-sonnet-5-5）。3段目は ANTHROPIC_MODEL
# ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5
# ANTHROPIC_MODEL_SONNET=claude-sonnet-5-5

# ---------------------------------------------------------------- 生徒の復習
# 「本人の ChatGPT で復習」（B方式。いまの方針。docs/REVIEW-CHATGPT.md）は、ここの環境変数を何も使わない
# （AI を呼ばない。学校・クラスの設定は設定画面で。0015_review_copy.sql が必要）。
#
# 以下は、アプリ内の AI との会話（A方式「チャッピー先生」。いまは使わない）を使う場合だけ。
# A方式は TUTOR_INAPP=on のときだけ動く（既定は無効：画面に出さず、会話の開始・キーの登録・同意の API もサーバーが断る）
# TUTOR_INAPP=on
# ---------------------------------------------------------------- チャッピー先生（A方式：生徒の音声復習）
# AI の利用料は生徒本人（または保護者）が OpenAI と直接契約して支払う。学校・管理者の OpenAI キーは置かない
# （OPENAI_API_KEY を設定しても、チャッピー先生は読まない）。
# チャッピー先生を使うときは必須（会話ごとに、通話を切るための資格情報を暗号化して置く。生徒がキーを保存するときも使う）。32バイトの乱数を base64 で。
#   作り方: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   DB には置かない。変えると、保存済みのキーは復号できなくなる（生徒に登録し直してもらう）。
#   この値と DB の暗号文の両方を扱える人（Vercel と Supabase の管理者）は、技術的には生徒のキーを復号できる。見られる人を最小限にする。
# TUTOR_KEY_ENCRYPTION_KEY=
# チャッピー先生を使うときは必須：見回り（ブラウザが来なくても通話を切る定期処理。docs/TUTOR-SWEEP.md）
#   SUPABASE_SERVICE_ROLE_KEY … 見回りの DB 関数を呼ぶためだけ（NEXT_PUBLIC_ を付けない）
#   CRON_SECRET … 32文字以上の乱数。Supabase の Vault の tutor_sweep_secret と同じ値
# CRON_SECRET=
# 任意。生存確認が途絶えたとみなす秒数（既定 90、30〜600）
# TUTOR_STALE_SECONDS=90
# 任意。チャッピー先生だけを止める（既存の採点は止まらない）
# TUTOR_FEATURE=off
# 任意。概算料金の単価（OpenAI の料金表を見て管理者が入れる。1M トークンあたりの米ドル）。無ければ概算料金は出さない
# TUTOR_PRICES_JSON={"モデル名":{"text_in":0,"text_out":0,"audio_in":0,"audio_out":0}}
