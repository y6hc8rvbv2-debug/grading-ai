<?xml version="1.0" encoding="utf-8"?>
<!-- 端末のバックアップ・機種変更の引き継ぎに、ログインの情報や答案の表示のキャッシュを含めない（Android 12 以降） -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
