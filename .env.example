# ── AI（必須：これが無い間は「デモ表示」で動きます） ──
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# APP_ACCESS_CODE=          # 設定すると、合言葉を知っている人だけがAIを使えます

# ── 個人情報の暗号化（PII Shield）: npx pii-shield keygen で作成 ──
PII_KEY_V1=
PII_INDEX_KEY=

# ── 共有機能（ライブラリ・利用者の声・生徒提出の中継）: Vercel の Upstash for Redis 連携で自動設定 ──
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── 決済（Stripe）: 売上は Stripe に登録した銀行口座へ入金されます ──
STRIPE_SECRET_KEY=          # Stripe管理画面 → 開発者 → APIキー（最初はテスト用 sk_test_ で確認）
STRIPE_WEBHOOK_SECRET=      # Stripe管理画面 → 開発者 → Webhook で「https://（公開URL）/api/stripe-webhook」を追加すると表示される whsec_…

# ── iPhoneアプリ内課金（Apple）: 手順は docs/IOS-RELEASE.md ──
APPLE_BUNDLE_ID=            # アプリのID（例: jp.jugyostudio.app）。capacitor.config.ts と同じ値
APPLE_APP_ID=               # App Store Connect の「Apple ID」（数字）。本番の購入確認に必要

# ── 管理者・Google連携（任意） ──
ADMIN_KEY=
GOOGLE_CLIENT_ID=
