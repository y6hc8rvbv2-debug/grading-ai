# ── AI（必須：これが無い間は「デモ表示」で動きます） ──
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# APP_ACCESS_CODE=          # 設定すると、合言葉を知っている人だけがAIを使えます

# ── 個人情報の暗号化（PII Shield）: npx pii-shield keygen で作成 ──
PII_KEY_V1=
PII_INDEX_KEY=

# ── 共有機能（ライブラリ・利用者の声・生徒提出の中継）: Vercel の Upstash for Redis 連携で自動設定 ──
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── 決済・管理者・Google連携（任意） ──
STRIPE_SECRET_KEY=
ADMIN_KEY=
GOOGLE_CLIENT_ID=
